# Локальная конфигурация и секреты; в Git остаются только безопасные примеры.
.env
.env.*
!.env.example
!.env.*.example

# Зависимости и результаты сборки.
node_modules/
dist/
coverage/

# Локальные Go-бинарники и результаты проверок.
apps/api/bin/
apps/api/migrations/.create.lock
*.test
*.prof
.task/

