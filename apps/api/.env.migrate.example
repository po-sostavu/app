# Local migration role. Copy to .env.migrate and set the password from infra/.env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=posostavu
DB_USER=posostavu_migrator
DB_PASSWORD=replace-with-local-migration-password
# Only for the local PostgreSQL container. Use verify-full outside local development.
DB_SSLMODE=disable
DB_CONNECT_TIMEOUT=5s
