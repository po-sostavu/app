# Load explicitly: go run ./cmd/api -env-file .env
# Existing environment variables have priority over this file.
HTTP_ADDR=127.0.0.1:8081
HTTP_REQUEST_TIMEOUT=10s
HTTP_SHUTDOWN_TIMEOUT=10s
HTTP_READ_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=30s
HTTP_BODY_LIMIT=1048576
HTTP_CONCURRENCY=1024
LOG_LEVEL=INFO

DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=posostavu
DB_USER=posostavu_app
# Set the APP_DB_PASSWORD from infra/.env. Empty values fail validation.
DB_PASSWORD=
# Plaintext is only for the local Compose network. Default: verify-full.
DB_SSLMODE=disable
DB_MAX_OPEN_CONNS=10
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=5m
DB_CONNECT_TIMEOUT=5s
DB_QUERY_TIMEOUT=2s
