# Replace each placeholder with a different local password before first start.
POSTGRES_PASSWORD=replace-with-local-admin-password
APP_DB_PASSWORD=replace-with-local-api-password
MIGRATOR_DB_PASSWORD=replace-with-local-migration-password

# Ports are published on 127.0.0.1 only.
POSTGRES_PORT=5432
API_PORT=8081
WEB_PORT=8080
