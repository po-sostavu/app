{
  "plugins": ["@trivago/prettier-plugin-sort-imports"],
  "importOrder": [
    "^react$",
    "^react-dom(/.*)?$",
    "<THIRD_PARTY_MODULES>",
    "^@/app(/.*)?$",
    "^@/pages(/.*)?$",
    "^@/widgets(/.*)?$",
    "^@/features(/.*)?$",
    "^@/entities(/.*)?$",
    "^@/shared(/.*)?$",
    "^[./]"
  ],
  "importOrderSeparation": true,
  "importOrderSortSpecifiers": true,
  "importOrderSideEffects": false,
  "importOrderParserPlugins": ["typescript", "jsx"],
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "semi": true,
  "endOfLine": "lf"
}
